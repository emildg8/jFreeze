# === jFreeze: бесплатный режим по умолчанию ===
# Все переменные ниже опциональны. Без них работают: демо-заказы, умная корзина (без AI),
# эвристика фото холодильника, SQLite локально.

# SQLite database path (локальный файл, $0)
DATABASE_URL=./data/jfreeze.db

# ОПЦИОНАЛЬНО — платный API провайдера (OpenAI pay-as-you-go).
# Без ключа: фото через эвристику, AI-совет корзины отключён.
# OPENAI_API_KEY=

# Capacitor Android: URL вашего dev-сервера (бесплатная сборка через Android Studio)
CAPACITOR_SERVER_URL=http://10.0.2.2:3000
