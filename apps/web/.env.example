# === jFreeze: бесплатный режим по умолчанию ===
# Все переменные ниже опциональны. Без них работают: демо-заказы, умная корзина (без AI),
# эвристика фото холодильника, SQLite локально.

# SQLite database path (локальный файл, $0)
DATABASE_URL=./data/jfreeze.db

# === Авторизация (личный кабинет) ===
# Сгенерируйте: openssl rand -base64 32
AUTH_SECRET=замените_на_случайную_строку_32_байта
# AUTH_URL=http://localhost:3000

# Google OAuth (бесплатно в Google Cloud Console)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Apple Sign In (Apple Developer)
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# Почта — magic link (SMTP, бесплатно: Yandex / Gmail app password)
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# Телефон: в dev код показывается в UI (AUTH_DEV_OTP=1)
# SMS_WEBHOOK_URL=https://your-sms-gateway/send
AUTH_DEV_OTP=1

# ОПЦИОНАЛЬНО — платный API провайдера (OpenAI pay-as-you-go).
# Без ключа: фото через эвристику, AI-совет корзины отключён.
# OPENAI_API_KEY=

# Capacitor Android: URL вашего dev-сервера (бесплатная сборка через Android Studio)
CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# Telegram-бот (бесплатно у @BotFather) — уведомления и семейная лента фото/файлов
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=my_jfreeze_bot
# PUBLIC_APP_URL=http://localhost:3000
# TELEGRAM_WEBHOOK_SECRET=случайная_строка_для_продакшена

# Опционально — детальный разбор QR чека ОФД (proverkacheka.com, BYOK)
# PROVERKA_CHEKA_TOKEN=

# Cron: защита GET /api/sources/sync и фоновых скриптов
# CRON_SECRET=
# JFREEZE_URL=http://127.0.0.1:3000
